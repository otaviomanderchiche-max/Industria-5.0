{
  "name": "NEXUS",
  "version": "1.0.0",
  "tools": [
    {"name":"nexus_get_graph","description":"Read the current NEXUS graph.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{}}},
    {"name":"nexus_search","description":"Search NEXUS nodes by text.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"]}},
    {"name":"nexus_get_node","description":"Read one NEXUS node.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"}},"required":["nodeId"]}},
    {"name":"nexus_list_children","description":"List direct child nodes.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"}},"required":["nodeId"]}},
    {"name":"nexus_list_connections","description":"List connections for a node.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"}},"required":["nodeId"]}},
    {"name":"nexus_list_files","description":"List files linked to a node.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"}},"required":["nodeId"]}},
    {"name":"nexus_get_activity","description":"Read recent NEXUS activity.","annotations":{"readOnlyHint":true},"inputSchema":{"type":"object","properties":{"limit":{"type":"integer","minimum":1,"maximum":100}}}},
    {"name":"nexus_create_node","description":"Create a NEXUS node.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"name":{"type":"string"},"type":{"type":"string"},"meta":{"type":"string"},"note":{"type":"string"},"x":{"type":"number"},"y":{"type":"number"},"parentId":{"type":"string"}},"required":["name"]}},
    {"name":"nexus_update_node","description":"Update fields on a NEXUS node.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"},"patch":{"type":"object"}},"required":["nodeId","patch"]}},
    {"name":"nexus_move_node","description":"Change node position in the graph.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"},"x":{"type":"number"},"y":{"type":"number"}},"required":["nodeId","x","y"]}},
    {"name":"nexus_connect_nodes","description":"Create a connection between nodes.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"sourceId":{"type":"string"},"targetId":{"type":"string"},"type":{"type":"string"}},"required":["sourceId","targetId"]}},
    {"name":"nexus_upload_file","description":"Register/upload a file and link it to one or more nodes.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"name":{"type":"string"},"mime":{"type":"string"},"nodeIds":{"type":"array","items":{"type":"string"}},"dataBase64":{"type":"string","description":"Base64 do conteúdo do arquivo. Use apenas quando o host conseguir fornecer os bytes do anexo."}},"required":["name","nodeIds","dataBase64"]}},
    {"name":"nexus_replace_file","description":"Replace file contents while preserving links.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"fileId":{"type":"string"},"name":{"type":"string"},"mime":{"type":"string"},"dataBase64":{"type":"string","description":"Base64 do novo conteúdo do arquivo."}},"required":["fileId","dataBase64"]}},
    {"name":"nexus_prepare_delete_node","description":"Preview deletion impact; does not delete.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"nodeId":{"type":"string"}},"required":["nodeId"]}},
    {"name":"nexus_confirm_delete_node","description":"Confirm a previously prepared node deletion.","annotations":{"readOnlyHint":false,"destructiveHint":true},"inputSchema":{"type":"object","properties":{"confirmationId":{"type":"string"}},"required":["confirmationId"]}},
    {"name":"nexus_prepare_delete_file","description":"Preview file deletion impact; does not delete.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"fileId":{"type":"string"}},"required":["fileId"]}},
    {"name":"nexus_confirm_delete_file","description":"Confirm a previously prepared file deletion.","annotations":{"readOnlyHint":false,"destructiveHint":true},"inputSchema":{"type":"object","properties":{"confirmationId":{"type":"string"}},"required":["confirmationId"]}},
    {"name":"nexus_prepare_disconnect_nodes","description":"Preview connection removal; does not disconnect.","annotations":{"readOnlyHint":false,"destructiveHint":false},"inputSchema":{"type":"object","properties":{"edgeId":{"type":"string"}},"required":["edgeId"]}},
    {"name":"nexus_confirm_disconnect_nodes","description":"Confirm a previously prepared connection removal.","annotations":{"readOnlyHint":false,"destructiveHint":true},"inputSchema":{"type":"object","properties":{"confirmationId":{"type":"string"}},"required":["confirmationId"]}}
  ]
}
